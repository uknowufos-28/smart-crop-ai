# SmartCropAI Enterprise Git Exclusion Policy

# 02_dataset/ - Exclude raw, temporary, and large image datasets
02_dataset/raw/
02_dataset/processed/
02_dataset/*.zip
02_dataset/*.tar.gz

# 03_model_training/ - Exclude trained model checkpoints & weights
03_model_training/checkpoints/
03_model_training/saved_models/
03_model_training/*.h5
03_model_training/*.pb
03_model_training/*.keras
03_model_training/logs/
03_model_training/.venv/

# 04_model_conversion/ - Exclude raw intermediate exported binaries
04_model_conversion/*.tflite
04_model_conversion/*.onnx
!04_model_conversion/samples/

# 05_mobile_app/ - Exclude React Native dependencies and build outputs
05_mobile_app/node_modules/
05_mobile_app/.expo/
05_mobile_app/android/.gradle/
05_mobile_app/android/app/build/
05_mobile_app/ios/Pods/
05_mobile_app/ios/build/
05_mobile_app/*.apk
05_mobile_app/*.aab
05_mobile_app/*.ipa

# 06_backend/ - Exclude Node.js dependencies and environment secrets
06_backend/node_modules/
06_backend/dist/
06_backend/.env
06_backend/.env.*
!06_backend/.env.example

# 07_testing/ - Exclude test logs & coverage reports
07_testing/coverage/
07_testing/logs/

# 08_deployment/ - Exclude local secrets and build artifacts
08_deployment/secrets/

# Global OS & IDE System Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
npm-debug.log*
yarn-debug.log*
