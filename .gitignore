# ==========================================
# SmartCropAI Enterprise Unified .gitignore
# Merged Rules for Python, Node.js, & React Native/Expo
# ==========================================

# 1. Node.js & React Native / Expo
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.expo/
.expo-shared/
web-build/
dist/
build/
.next/

# 2. Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# 3. Python & Machine Learning
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
.pytest_cache/
.coverage
htmlcov/
*.log
*.keras

# 4. OS & IDE Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# 5. Raw Large Datasets (Exclude raw un-split image zips)
02_dataset/raw_download/
*.zip
*.tar.gz
